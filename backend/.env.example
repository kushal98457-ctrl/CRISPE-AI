# CRISPE-AI Backend Configuration Template
# Copy this file to backend/.env and replace placeholders with your actual settings.
# NEVER commit backend/.env to source control.

# Application Identity & Network
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DEBUG=False
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Google AI Studio / Gemini Provider Configuration
# Get your API key at: https://aistudio.google.com/apikey
# Supports either GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_YOUR_KEY
PRIMARY_MODEL=gemma-4-26b-a4b-it
FALLBACK_MODEL=gemini-2.5-flash
REFLECTION_MODEL=gemini-2.5-flash

# Gemini Operational Limits & Timeouts (Step 6)
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_DEFAULT_TEMPERATURE=0.4
GEMINI_ENABLE_THINKING=False

# Semantic Memory & Vector Database (PostgreSQL + pgvector)
# Format: postgresql+psycopg://username:password@hostname:5432/database_name
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crispe_ai

# Semantic Embedding Configuration (Step 12)
EMBEDDING_PROVIDER=google-genai
EMBEDDING_MODEL_ID=text-embedding-004
EMBEDDING_DIMENSIONS=768
EMBEDDING_CONFIG_VERSION=v1
EMBEDDING_SIMILARITY_METRIC=cosine
EMBEDDING_MAX_INPUT_TOKENS=2048
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=10.0
# EMBEDDING_API_KEY=AIzaSy_OPTIONAL_DEDICATED_KEY

# Optimization Job Limits (Feature A)
DEFAULT_MAX_ITERATIONS=5
MAX_BUDGET_USD_PER_RUN=2.50
MAX_CONCURRENT_RUNS=2
