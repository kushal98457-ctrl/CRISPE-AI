# CRISPE-AI Backend Configuration Template
# Copy to backend/.env and replace placeholders with your actual settings.
# NEVER commit backend/.env to source control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Google AI Studio / Gemini API Configuration
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_YOUR_API_KEY_HERE
PRIMARY_MODEL=gemma-4-26b-a4b-it
FALLBACK_MODEL=gemini-2.5-flash
REFLECTION_MODEL=gemini-2.5-flash

# Semantic Memory & Vector Database (PostgreSQL + pgvector)
# Format: postgresql+psycopg://username:password@hostname:5432/database_name
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crispe_ai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Optimization Job Limits (Feature A)
DEFAULT_MAX_ITERATIONS=5
MAX_BUDGET_USD_PER_RUN=2.50
MAX_CONCURRENT_RUNS=2
